{
  "name": "mango-ui",
  "version": "2.0.0",
  "description": "Mango UI — a cyberpunk, digital-time-travel flavoured Vue 3 component library. Neon effects that wrap, futuristic elements that glow.",
  "type": "module",
  "license": "MIT",
  "author": "zhang1024899756",
  "homepage": "https://github.com/zhang1024899756/mango-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang1024899756/mango-ui.git"
  },
  "bugs": {
    "url": "https://github.com/zhang1024899756/mango-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui-kit",
    "typescript",
    "cyberpunk",
    "effects",
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui-kit",
    "typescript",
    "effects"
  ],
  "main": "./dist/mango-ui.cjs",
  "module": "./dist/mango-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mango-ui.js",
      "require": "./dist/mango-ui.cjs"
    },
    "./style.css": "./dist/mango-ui.css",
    "./dist/style.css": "./dist/mango-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.d.ts.json --emitDeclarationOnly",
    "build": "pnpm build:lib && pnpm build:types",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "plop": "plop --plopfile plopfile.cjs",
    "clean": "rimraf dist storybook-static docs/.vitepress/dist docs/.vitepress/cache"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "markdown-it-container": "4.0.0",
    "plop": "^4.0.5",
    "rimraf": "^6.0.1",
    "sass": "^1.108.1",
    "storybook": "^10.6.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "defaults",
    "last 2 versions",
    "not dead"
  ]
}
